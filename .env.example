# Copy this file to .env next to WinAirdrop.exe (or winairdrop.py) to change
# anything. If .env does not exist it is created on first run.
# .env holds your token: never share it or commit it to a repository.

# Language of the settings page, notifications and file names: en or es.
# Empty = the installer's choice, or the Windows language.
WINAIRDROP_LANGUAGE=

# Name the PC announces on the network: the Shortcut uses <name>.local
# Empty = "winairdrop-<computer name>". Letters, digits and hyphens only.
WINAIRDROP_NAME=

# HTTP port. If you change it, run: .\setup-firewall.ps1 -Port <port>
WINAIRDROP_PORT=8770

# Where received files are saved (absolute, relative to the app, or with
# variables like %USERPROFILE%). Empty = Pictures\WinAirdrop
WINAIRDROP_FOLDER=

# Rename iOS photos and videos (IMG_1234, UUIDs, FullSizeRender) with their
# capture date, e.g. "Photo 2026-09-19 21.13.20.jpg". 1 = yes, 0 = keep names.
WINAIRDROP_RENAME_BY_DATE=1

# What happens on screen when files arrive:
#   open   = open the file in its default app, like AirDrop on a Mac
#            (several files at once: show them in File Explorer instead)
#   reveal = show the file selected in File Explorer
#   none   = just save it
WINAIRDROP_ON_RECEIVE=open

# Show a Windows notification (with a photo preview) when files arrive. 1 = yes, 0 = no.
WINAIRDROP_NOTIFICATIONS=1

# Token the Shortcut sends in the Authorization header. Empty = a random one is
# generated on first run. You can see it at http://localhost:8770/setup
WINAIRDROP_TOKEN=
